<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <!-- 1. Report ID and Category (3/9 width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_report_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#RPT12345"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/text_report_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Roads &amp; Transportation"
                android:textSize="12sp"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- 2. Location (3/9 width) -->
        <TextView
            android:id="@+id/text_report_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:text="123 Main St, Cityville"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginStart="8dp"/>

        <!-- 3. Status Chip (2/9 width) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_report_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="New"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            app:chipBackgroundColor="#E3F2FD"
            android:textColor="#1976D2"
            app:chipCornerRadius="4dp"
            app:chipMinHeight="32dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <!-- 4. Details Button (1/9 width) -->
        <Button
            android:id="@+id/button_report_details"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit"
            android:minWidth="0dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textSize="12sp"
            android:textColor="?attr/colorPrimary"
            android:maxLines="1"
            android:layout_marginStart="4dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>